# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ── Langflow / MCP Integration ────────────────────────────────────────────────
# Base URL of your running Langflow instance (default: http://localhost:7860)
LANGFLOW_BASE_URL="http://localhost:7860"

# Langflow API token (leave empty if auth is disabled)
LANGFLOW_TOKEN=""

# Flow IDs for each MCP tool (override if your flow IDs differ)
FLOW_MENGUKUR_GIZI="mengukur-gizi"
FLOW_IMAGE_GIZI="f7a2f956-4b7f-4693-b43d-90ccb566ef10"

environment:
  - LANGFLOW_SKIP_AUTH_AUTO_LOGIN=true
